# Local execution output and authoring state
/.acceptance/
/openspec/
/.agents/
/.codex/*
!/.codex/INSTALL.md
!/.codex/skills/
/.claude/*
!/.claude/INSTALL.md
!/.claude/skills/

# Python environments and generated test/cache files
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Blender recovery files; intentional .blend assets remain eligible
*.blend[0-9]*
*.blend@

# Local credentials and editor/OS noise
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local evaluation fixtures
/tests/
